otel-collector:
    image: otel/opentelemetry-collector:0.95.0
    container_name: titan_library_otel_collector
    restart: unless-stopped
    ports:
      - "8888:8888" 
      - "8889:8889" 
      - "13133:13133"
      - "4317:4317"
    command: ["--config=/etc/otel-collector-config.yml"]
    volumes:
      - ./docker/otel-collector/otel-collector.yml:/etc/otel-collector-config.yml
