{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "CHANGE_ME_USE_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS",
    "Issuer": "Titan.Library",
    "Audience": "Titan.Library.Clients",
    "ExpiresInMinutes": 60
  }
}
